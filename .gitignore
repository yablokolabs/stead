# Secrets — never commit. The real env file lives in STEAD_DEMO_HOME.
.env
.env.*
!.env.example

# Worker secrets for `wrangler dev`. In production these are Worker secrets,
# set with `wrangler secret put` and never written to disk here.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Demo state — lives in STEAD_DEMO_HOME, never in the repo.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Logs
*.log
logs/

# Private VM migration bundles — contain credentials and household history.
stead-private-*.tar.gz
stead-backups/
backups/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Node — web/ and worker/
node_modules/
dist/
.wrangler/
*.tsbuildinfo

# Worktrees
.worktrees/
