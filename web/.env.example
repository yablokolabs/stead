# Stead web — example environment. PLACEHOLDERS ONLY.
#
# Copy to web/.env.local for local development. Everything here is compiled
# into the browser bundle and is therefore PUBLIC. Nothing secret may appear
# in this file or in .env.local.
#
# On Cloudflare Pages these are set as build-time environment variables in the
# dashboard, per environment. See docs/CLOUDFLARE_MVP.md.

# Supabase project URL.
VITE_SUPABASE_URL=https://REPLACE_ME.supabase.co

# The browser-safe PUBLISHABLE key (sb_publishable_...), or the legacy anon key.
# NEVER the service-role / secret key — it would be readable by every visitor.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Origin of the Cloudflare Worker gateway. `npx wrangler dev` serves 8788, set
# in worker/wrangler.jsonc. Production is the Worker's route or its
# workers.dev subdomain, e.g. https://api.getstead.app
VITE_STEAD_API_URL=http://localhost:8788
