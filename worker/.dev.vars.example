# Stead gateway — local development values. PLACEHOLDERS ONLY.
#
# Copy to worker/.dev.vars for `wrangler dev`. That file is gitignored and must
# never be committed.
#
# In production the two N8N_* values are Cloudflare Worker secrets:
#
#   npx wrangler secret put N8N_WEBHOOK_URL
#   npx wrangler secret put N8N_WEBHOOK_SECRET
#
# SUPABASE_URL and ALLOWED_ORIGIN are not secret and live in wrangler.jsonc as
# plain vars, holding their PRODUCTION values. Anything set here overrides them
# for local development only.

# The dev server's origin. wrangler.jsonc holds the deployed Pages origin, so
# without this line `wrangler dev` refuses requests from `npm run dev`.
ALLOWED_ORIGIN=http://localhost:5173

# The n8n Cloud Webhook trigger's production URL. Secret: anyone holding it can
# invoke the Stead agent directly, bypassing this gateway's identity check.
N8N_WEBHOOK_URL=https://REPLACE_ME.app.n8n.cloud/webhook/REPLACE_ME

# Shared secret, sent as X-Stead-Webhook-Secret. The n8n workflow must reject
# any request whose header does not match. Generate one with:
#   openssl rand -hex 32
N8N_WEBHOOK_SECRET=REPLACE_ME
