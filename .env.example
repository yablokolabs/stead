# Stead Preview — example environment.
# Copy to $STEAD_DEMO_HOME/.env and fill in. NEVER commit the real file.
#   install -m 600 /dev/null "$STEAD_DEMO_HOME/.env"
#
# Placeholders only. No real value belongs in this file.

# --- Telegram (from BotFather, for the "Stead Preview" bot only) -------------
# Must NOT be the same token as any other bot on this machine.
STEAD_TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN

# Comma-separated numeric Telegram user IDs permitted to talk to Stead.
# Kerstin's ID only. Anyone else is rejected.
STEAD_ALLOWED_TELEGRAM_IDS=000000000

# --- Model provider ----------------------------------------------------------
# "anthropic" reuses the existing claude_code OAuth credential (no new key).
# "gemini" requires GEMINI_API_KEY below and shares nothing with other agents.
STEAD_MODEL_PROVIDER=anthropic
STEAD_MODEL_NAME=claude-opus-4-5

# Provider credential — supply ONLY the one matching STEAD_MODEL_PROVIDER.
# anthropic: leave unset to inherit the claude_code OAuth credential source.
# ANTHROPIC_API_KEY=
# gemini: mint a dedicated key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=

# --- Locale ------------------------------------------------------------------
STEAD_TIMEZONE=Europe/London

# --- Workspace ---------------------------------------------------------------
# Holds the SQLite demo database, the real .env and logs. Outside git, mode 700.
STEAD_DEMO_HOME=/home/azureuser/.stead-demo
